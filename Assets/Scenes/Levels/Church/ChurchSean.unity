    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[0].text
      value: Ah old St Sergio's Spinner Puzzle! Each orb must be spun a specific
        amount of times to progress
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[1].text
      value: How does spinning some orbs help us out here?
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[2].text
      value: Hah! Phiast you old fool, St Sergio was a master of craft! Well, in
        his way. Not very dependable or sensical. Strange obsession with bevels and
        towers...
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[3].text
      value: Regardless, this must guard the path to the well. Clues are probably,
        randomly strewn about the place
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[4].text
      value: How fun...
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[0].charSprite
