    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[0].text
      value: Quick you fiend! Jump!
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[1].text
      value: I can't! You're weighing me down
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[2].text
      value: What sort of fearsome creature cannot carry a single holy skull?!
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[3].text
      value: Did you forget the pot you forced onto me? I've barely eaten in one-thousand,
        two hundred years. Maybe there's another way..
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[4].text
      value: Hm? You better not be thinking of *Throwing* me over there using the
        [Left Mouse Button] or [Right Trigger!
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[5].text
      value: Quick you fiend! Jump!
      objectReference: {fileID: 0}
