    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[0].text
      value: Look ahead! Those shades still pursue us!
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[1].text
      value: Don't worry priest, I swore I'd protect you
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[2].text
      value: Yes, yes hooow heroic. Listen here, if they grab me they'll drag me
        down to the depths with them!
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[3].text
      value: Nothing my signature Phiast punch can't sort out. One tap of the [Shift
        key] or {Right Bumper] and you'll be free
      objectReference: {fileID: 0}
