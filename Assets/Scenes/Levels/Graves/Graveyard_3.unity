    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[0].text
      value: What's that smell? My nostrils are burning!
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[1].text
      value: Careful Phiast! "Grannys Blitz"! A tasty looking fruit but an explosive
        one
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[2].text
      value: It DOES look tasty...
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[3].text
      value: Lift that up and you'll be blown to bits in aproximately three seconds,
        fool! Only way to stop the blast is to place it back on a Granny Blitz patch
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[4].text
      value: 'Fine, the quest for freedom will have to keep me satisfied for now. '
      objectReference: {fileID: 0}
    - target: {fileID: 6426123050995192412, guid: 8c33098c500e1a84c95b7d20ac6dc6e2, type: 3}
      propertyPath: lines.Array.data[5].text
      value: whaddup
      objectReference: {fileID: 0}
